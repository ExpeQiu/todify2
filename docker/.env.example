# Todify4 Docker 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# 数据库初始化配置
INIT_DATABASE=1
FORCE_INIT=0

# 数据库配置
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/todify4.db

# PostgreSQL 配置（如果使用 PostgreSQL）
PG_HOST=todify4-postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=todify4
PG_EXTERNAL_PORT=5432

# Dify API 配置（可选）
DIFY_BASE_URL=
DIFY_WORKFLOW_BASE_URL=
AI_SEARCH_API_KEY=
TECH_PACKAGE_API_KEY=
TECH_STRATEGY_API_KEY=
TECH_ARTICLE_API_KEY=
TECH_PUBLISH_API_KEY=

# 博查 API 配置（可选）
BOCHA_API_KEY=
