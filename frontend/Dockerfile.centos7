# 前端 Dockerfile - CentOS 7 / Docker 1.13.1 兼容版本
# 注意：此版本不使用多阶段构建，因为 Docker 1.13.1 不支持（需要 17.05+）
FROM node:18-alpine

# 安装必要的工具
RUN apk add --no-cache nginx

# 设置工作目录
WORKDIR /app

# 复制 package 文件
COPY package*.json ./

# 安装依赖
RUN npm ci

# 复制源代码
COPY . .

# 构建生产版本
RUN npm run build

# 复制构建产物到 nginx
RUN mkdir -p /usr/share/nginx/html && \
    cp -r dist/* /usr/share/nginx/html/

# 复制 nginx 配置文件
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]

